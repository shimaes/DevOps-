#!/usr/bin/env bash
# get-ptr.sh - دریافت میل‌سرورهای دامنه و رکورد PTR مربوط به IPها

if [ -z "$1" ]; then
  echo "Usage: $0 domain"
  exit 1
fi

DOMAIN="$1"
echo "=== MX records for $DOMAIN ==="
dig +short "$DOMAIN" MX | sort -n | while read priority host; do
  echo "Priority: $priority - Host: $host"
  for ip in $(dig +short "$host" A; dig +short "$host" AAAA); do
    ptr=$(dig +short -x "$ip")
    echo "   $ip -> PTR: ${ptr:-No PTR found}"
  done
done


